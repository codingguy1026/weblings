# Drawing Chat / Drawing ID OAuth v0.3
# Copy to .env.local. Set these to the SAME Supabase Auth project as Drawing ID.
# These are placeholder values, not credentials.
DRAWING_SUPABASE_URL=https://your-project.supabase.co
DRAWING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Turn on only AFTER setting up the central OAuth Server and registering
# a separate Public OAuth client called "Drawing Chat".
DRAWING_SSO_ENABLED=false

# For compatibility with other Drawing services, the code also accepts
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
# NEXT_PUBLIC_DRAWING_SSO_ENABLED. Server-only names above are recommended
# because they work with runtime Docker environment variables.

# Must match the full deployed origin of THIS app, without a trailing slash,
# and match the exact redirect URI registered in Supabase OAuth Apps.
# For Codespaces, use its HTTPS forwarded-port 5173 origin.
DRAWING_SSO_ORIGIN=https://your-drawing-chat.example
DRAWING_SSO_CLIENT_ID=replace_with_public_client_id

# Registered OAuth redirect URI:
# https://your-drawing-chat.example/api/drawing-id/callback
# NEVER put service_role keys or OAuth client secrets in this app.

# Legacy Weblings Discord bot (kept for compatibility)
# Configure environment variables, never commit the real token.
DISCORD_TOKEN=your_discord_bot_token
TEST_GUILD_ID=
DATABASE_PATH=data/weblings.db
